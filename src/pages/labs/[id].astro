---
import { getCollection, render } from 'astro:content';
import Reading from '../../layouts/Reading.astro';
import { visible, url } from '../../lib/content';
export async function getStaticPaths() { return (await getCollection('labs', visible)).map(entry=>({params:{id:entry.id},props:{entry}})); }
const {entry}=Astro.props;
const {Content, headings}=await render(entry);
const project = entry.data.family === 'AI Governance' ? 'ai-governance' : 'rag-engineering';
---
<Reading title={entry.data.title} description={entry.data.description} kind="labs" draft={entry.data.draft} meta={`${entry.data.family} · ${entry.data.duration}`} headings={headings}><Content /><p class="note">{entry.data.repository ? <a href={entry.data.repository}>Actual lab code</a> : 'Actual lab code: repository not yet supplied.'}</p><p><a href={url(`projects/${project}/`)}>Related project: {entry.data.family} →</a></p></Reading>
