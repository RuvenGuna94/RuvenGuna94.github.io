---
import Base from '../layouts/Base.astro';
import ProjectCards from '../components/ProjectCards.astro';
import WritingList from '../components/WritingList.astro';
import { url } from '../lib/content';
---
<Base>
  <section class="intro" aria-labelledby="intro-title">
    <div class="intro-copy">
      <h1 id="intro-title">Hey, I’m Ruven.</h1>
      <p>I work in data and AI, and I like building things to understand how they work.</p>
      <p>Between work and everything else, I try to keep learning and make time to experiment. This is a space for the things I’m building, the questions I’m exploring, and guides for learning alongside a full-time job.</p>
      <div class="intro-links"><a href={url('projects/')}>Explore my projects <span aria-hidden="true">→</span></a><a href={url('writing/')}>Read my writing <span aria-hidden="true">→</span></a></div>
    </div>
    <div class="portrait portrait-photo"><img src={url('images/ruven-guna.webp')} alt="Ruven Guna smiling outdoors" width="1000" height="1500" decoding="async" fetchpriority="high" /></div>
  </section>
  <section class="section" aria-labelledby="projects-title"><div class="section-heading"><h2 id="projects-title">What I’m exploring</h2><a href={url('projects/')}>All projects <span aria-hidden="true">→</span></a></div><ProjectCards /></section>
  <section class="section" aria-labelledby="writing-title"><div class="section-heading"><h2 id="writing-title">From the notebook</h2><a href={url('writing/')}>All writing <span aria-hidden="true">→</span></a></div><WritingList limit={3} /></section>
</Base>
