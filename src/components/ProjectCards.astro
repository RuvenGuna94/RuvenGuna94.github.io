---
import { getCollection } from 'astro:content';
import { url } from '../lib/content';
interface Props { headingLevel?: 'h2' | 'h3' }
const { headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const projects = (await getCollection('projects')).sort((a,b) => a.data.order - b.data.order);
---
<div class="project-grid">
  {projects.map(project => <article class="project-card">
    <Heading><a href={url(`projects/${project.id}/`)}>{project.data.title}</a></Heading>
    <p>{project.data.description}</p>
    <div class="card-links"><a href={url(`projects/${project.id}/`)}>Project overview <span aria-hidden="true">↗</span></a><a href={url(`labs/#${project.id}`)}>Related labs <span aria-hidden="true">→</span></a></div>
  </article>)}
</div>
